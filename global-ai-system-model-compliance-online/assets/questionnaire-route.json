  },
  "omitted_theme_reasons": {
    "system": "轻量版始终通过D0做系统线索初筛；全量版未选择欧盟系统范围时不发送D1至D4详细题，后台记录为未评估。",
    "model": "轻量版始终通过E0做模型线索初筛；全量版未选择模型范围时不发送E1至E5详细题，后台记录为未评估。",
    "ancillary": "轻量版始终通过F0做AI平台附属线索初筛；全量版未选择附属筛查时不发送个人信息、跨境、版权、产品责任或Cookie详细题，后台记录为未评估。"
  },
  "omitted_detail_reasons": {
    "light_mode": "本次选择轻量版，只完成业务事实初筛；技术实现、文件版本、服务器、密钥、合同条款和法律角色尚未核验。",
    "technical_gate_not_enabled": "尚未明确表示能核对技术、数据或合同资料，因此只保留业务事实主线；相关细节进入补证清单，不重复追问业务填写人。"
  },
  "entry_progress_message_template": "模式题：{mode_status}；范围入口共 {public_entry_total} 步；已确认 {public_entry_confirmed} 步；已提交待内部核实 {public_entry_pending_verification} 步；尚未提交 {public_entry_not_received} 步；还需提交或更正 {public_entry_submission_remaining} 步。待核项已视为有效提交，不需要重复回答。模式确认后，轻量版固定为2组、每组5题（共10题）；全量版按范围为3至7组。",
  "progress_message_template": "本次共需完成 {total_groups} 组问卷；当前{current_label}；已完成 {completed_groups} 组；还剩 {remaining_groups} 组问卷。当前轮和整条路线的题号余量会另行显示。"
}
