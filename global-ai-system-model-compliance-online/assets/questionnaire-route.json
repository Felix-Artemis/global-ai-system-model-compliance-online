{
  "version": "2.5.1",
  "mode_step": "P0",
  "mode_values": {
    "light": "轻量版初步评估",
    "full": "全量版评估"
  },
  "legacy_missing_mode": "full",
  "entry_steps": ["P0", "P1", "P2", "P3", "P4"],
  "entry_rounds": [["P0"], ["P1", "P2", "P3", "P4"]],
  "public_entry_steps": ["P1", "P2", "P3", "P4"],
  "public_entry_rounds": [["P1", "P2", "P3", "P4"]],
  "backend_registration_keys": ["R1", "R2", "R3", "R4"],
  "visible_question_slot_count": 55,
  "question_policy": {
    "modes": ["light", "full"],
    "light_mode_group_count": 2,
    "light_mode_questions_per_group": 5,
    "light_mode_total_question_slots": 10,
    "full_mode_group_count_range": [3, 7],
    "layers": ["observable_business_facts", "gated_technical_detail"],
    "max_questions_per_round": 8,
    "min_questions_per_new_round": 2,
    "send_questions_in_groups": true,
    "send_one_question_at_a_time": false,
    "collect_evidence_after_key_facts": true,
    "technical_detail_gate_key": "P6",
    "technical_detail_requires_explicit_yes": true,
    "unknown_is_submitted_and_never_reasked": true,
    "retain_answered_rows": true,
    "send_only_unanswered_or_conflicting_rows": true
  },
  "fact_record_schema": {
    "description": "每条事实由后台随答案保存；这些字段不是要求业务人员作法律判断。",
    "required_fields": [
      "respondent_identity",
      "product_operator",
      "end_user",
      "model_developer_or_controller",
      "vendor_or_partner",
      "jurisdiction",
      "as_of_time",
      "source",
      "certainty"
    ],
    "certainty_values": ["confirmed", "reported", "uncertain", "conflicting"],
    "role_separation": [
      "skill_filler",
      "product_operator",
      "product_end_user",
      "model_developer_or_controller",
      "technical_vendor",
      "co_brand_or_partner"
    ],
    "evidence_fields": ["evidence_name", "evidence_date", "evidence_location"]
  },
  "route_lock_policy": {
    "lock_after_entry": true,
    "lock_after_backend_registration": true,
    "lock_basis": ["P0", "P1", "P2", "P3", "P4", "R1", "R2", "R3", "R4"],
    "backend_registration_required": true,
    "backend_registration_is_auto_derived": true,
    "signature_required": true,
    "locked_state_fields": ["route_signature", "locked_total_groups", "enabled_group_ids"],
    "entry_changes_after_lock": "record_conflict_and_request_correction; do_not_silently_change_total_groups",
    "signature_algorithm": "sha256(canonical_entry_and_enabled_group_ids)"
  },
  "progress_policy": {
    "route_locked_after": "P1,P2,P3,P4 plus generated or explicitly confirmed R1,R2,R3,R4",
    "entry_status_labels": {
      "complete": "已确认",
      "submitted_uncertain": "已提交，待内部核实",
      "received_needs_completion": "已提交，还需补充",
      "not_received": "尚未提交",
      "conflict": "需要更正"
    },
    "group_complete_when": "all_assigned_rows_have_a_submitted_answer_or_are_recorded_not_applicable_with_reason",
    "unknown_answer_counts_as_submitted_but_remains_pending": true,
    "unknown_answer_is_not_reasked": true,
    "partial_group_rule": "retain_answered_rows_and_send_only_unanswered_or_conflicting_rows",
    "conflicting_rows_count_as": "unanswered_until_corrected",
    "not_yet_sent_rounds": "do_not_count_as_missing_until_the_round_is_assigned"
  },
  "light_group_templates": [
    {
